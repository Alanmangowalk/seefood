{
  "name": "seefood",
  "main": "./worker.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "exclude": [
      "worker.js",
      "wrangler.jsonc",
      "README.md",
      ".git/**",
      "node_modules/**"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seefood-staging",
      "database_id": "7cdcb658-6db9-443a-9b0a-6135bdc7b055"
    }
  ]
}
