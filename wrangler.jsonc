{
  "name": "seefood-d1-shadow",
  "main": "./worker.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seefood-staging",
      "database_id": "7cdcb658-6db9-443a-9b0a-6135bdc7b055"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
